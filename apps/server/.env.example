DATABASE_URL=postgresql://repin:repin@localhost:5432/repin
REDIS_URL=redis://localhost:6379
PORT=3001
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
# Comma-separated Chrome Web Store extension IDs. Empty permits unpacked dev IDs.
EXTENSION_CLIENT_IDS=
ACCESS_TOKEN_TTL=900000
REFRESH_TOKEN_TTL=604800000
EXTENSION_AUTHORIZATION_CODE_TTL=60000
EXTENSION_REFRESH_TOKEN_TTL=2592000000
CORS_ORIGIN=http://localhost:3000
ENABLE_SWAGGER=true

# Email delivery: log (development only), resend, smtp, or sendgrid.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=Repin
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT=120000
ASSISTANT_RATE_LIMIT_MAX=25
ASSISTANT_NO_PROGRESS_THRESHOLD=3
ASSISTANT_SHORT_MAX_TOOL_CALLS=24
ASSISTANT_LONG_MAX_TOOL_CALLS=120
# Optional per-capability overrides. Zero disables the tool-call budget.
# ASSISTANT_SUMMARIZE_MAX_TOOL_CALLS=8
# ASSISTANT_EXPLAIN_MAX_TOOL_CALLS=8
# ASSISTANT_TRANSLATE_MAX_TOOL_CALLS=4
# ASSISTANT_CHAT_MAX_TOOL_CALLS=48
ASSISTANT_RATE_LIMIT_DURATION=60000
ASSISTANT_SCALE_CHECK_INTERVAL=15000
ASSISTANT_SCALE_DEPTH_THRESHOLD=20
ASSISTANT_SCALE_WAIT_THRESHOLD=5000

# OpenTelemetry is opt-in. Set OTEL_ENABLED=true or provide an OTLP endpoint.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=repin-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=60000
