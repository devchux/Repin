DATABASE_URL=postgresql://repin:repin@localhost:5432/repin
REDIS_URL=redis://localhost:6379
PORT=3001
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900000
REFRESH_TOKEN_TTL=604800000
CORS_ORIGIN=http://localhost:3000
ENABLE_SWAGGER=true
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_REQUEST_TIMEOUT=120000
ASSISTANT_RATE_LIMIT_MAX=25
ASSISTANT_RATE_LIMIT_DURATION=60000
ASSISTANT_SCALE_CHECK_INTERVAL=15000
ASSISTANT_SCALE_DEPTH_THRESHOLD=20
ASSISTANT_SCALE_WAIT_THRESHOLD=5000

# OpenTelemetry is opt-in. Set OTEL_ENABLED=true or provide an OTLP endpoint.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=repin-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=60000
