NODE_ENV=production
SERVER_PORT=3001
WEB_PORT=3000

POSTGRES_USER=repin
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=repin
DATABASE_URL=postgresql://repin:replace-with-a-strong-password@postgres:5432/repin

REDIS_URL=redis://redis:6379

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=900000
REFRESH_TOKEN_TTL=604800000

CORS_ORIGIN=https://your-production-domain.example
ENABLE_SWAGGER=false

# Server-side URL used by the Next.js proxy. When running the web app outside
# Docker, the proxy defaults to http://localhost:3001/api. Docker Compose
# overrides this with http://server:3001/api.
BACKEND_API_URL=http://localhost:3001/api

AI_PROVIDER=openai
AI_API_KEY=replace-with-your-provider-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT=120000
